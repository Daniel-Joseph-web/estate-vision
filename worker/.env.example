# Shared secret the frontend sends as the X-Worker-Secret header.
# Must match WORKER_SECRET in the frontend's environment. Minimum 16 chars.
WORKER_SECRET=03dJBT04DxzRhkq8TraxPxpXtxX6bX50zDDYLDaUM1g

# --- Firebase (for Firestore writes) ---
# Path to service account JSON file, or the JSON string itself.
FIREBASE_CREDENTIALS_JSON=

# --- Object storage (same bucket the frontend presigns uploads to) ---
# These must match frontend/.env.local exactly, or the worker will download
# from the wrong endpoint and every storage key will look missing.
S3_BUCKET=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare R2 endpoint. Leave empty to use real Amazon S3.
AWS_ENDPOINT=

# --- Pipeline tuning (all optional; defaults shown) ---
# Frames sampled per second of footage.
SAMPLE_FPS=1.0
# Ultralytics model. yolov8n is fastest; yolov8s/m trade speed for accuracy.
YOLO_MODEL=yolov8n.pt
# Detections below this confidence are dropped.
MIN_CONFIDENCE=0.35
# Rows per Firestore batch write (hard limit is 500).
WRITE_BATCH_SIZE=500
# Refuse videos longer than this many seconds (default 4 hours).
MAX_DURATION_SECONDS=14400
# Scratch space for downloads and frames.
TEMP_DIR=/tmp/estatevision
